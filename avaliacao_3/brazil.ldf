% Compatibilidade mínima para a instalação reduzida do Babel deste ambiente.
% O texto e os títulos em português são definidos explicitamente em main.tex.
\ProvidesLanguage{brazil}[2026/08/06 minimal Brazilian Portuguese support]
\LdfInit{brazil}{captionsbrazil}
\ifx\l@brazil\@undefined
  \adddialect\l@brazil\l@english
\fi
\providehyphenmins{\CurrentOption}{\tw@\thr@@}
\let\captionsbrazil\captionsenglish
\let\datebrazil\dateenglish
\let\extrasbrazil\relax
\let\noextrasbrazil\relax
\ldf@finish{brazil}
